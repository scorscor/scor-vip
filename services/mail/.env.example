SMTP_HOST=smtp.qcloudmail.com
SMTP_PORT=465
SMTP_USERNAME=token@scor.vip
SMTP_PASSWORD=
SMTP_FROM=token@scor.vip
# JSON mapping: give each application a separate random key of >=32 characters.
MAIL_API_KEYS={}
# UTC day; all callers combined. Keep below the Tencent account's available quota.
MAIL_DAILY_LIMIT=100
MAIL_DATABASE=/app/data/mail.sqlite3
